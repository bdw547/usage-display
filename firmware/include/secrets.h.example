// firmware/include/secrets.h.example — copy to secrets.h and fill in.
// Values come from ~/.config/usage-collector/tokens.json (written at relay deploy).
#pragma once
#define RELAY_URL        "https://usage-relay.YOURSUBDOMAIN.workers.dev"
#define RELAY_READ_TOKEN "paste-READ_TOKEN-here"
// POSIX TZ string for the status-bar clock (default: US Central)
#define TZ_POSIX "CST6CDT,M3.2.0,M11.1.0"
